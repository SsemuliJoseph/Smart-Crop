# PotatoGuard Environment Variables
# Copy this file to .env and fill in the actual values

# Frontend API Configuration
API_BASE_URL=https://YOUR_API_GATEWAY_URL/prod

# AWS SageMaker ML Model
SAGEMAKER_ENDPOINT=potatoguard-endpoint

# AWS DynamoDB Database
DYNAMODB_TABLE=potatoguard-detections

# AWS S3 Storage Buckets
S3_BUCKET=potatoguard-images
S3_BUCKET_MODELS=potatoguard-models

# AWS Region
AWS_REGION=us-east-1

# AWS Credentials (for backend deployment and Lambda functions)
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# Optional: For local testing
AWS_PROFILE=default

# Lambda Function Configuration
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# Model Configuration
MODEL_NAME=potatoguard_model.h5
MODEL_INPUT_SIZE=224
CONFIDENCE_THRESHOLD=0.75

# Disease Classifications
DISEASE_CLASSES=Healthy,Late Blight,Early Blight,Bacterial Wilt

# Treatment Advice (hardcoded, no secrets)
TREATMENT_HEALTHY=Your plant is healthy! Keep monitoring weekly.
TREATMENT_LATE_BLIGHT=Apply fungicide (Mancozeb or Chlorothalonil) immediately. Remove infected leaves.
TREATMENT_EARLY_BLIGHT=Apply copper-based fungicide. Improve air circulation between plants.
TREATMENT_BACTERIAL_WILT=Remove and destroy infected plants. Do not replant in same soil for 2 seasons.
